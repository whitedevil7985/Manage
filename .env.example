# Telegram bot token from BotFather
BOT_TOKEN=

# Telegram numeric user ID allowed to operate this bot
OWNER_ID=

# PostgreSQL connection string (recommended for Heroku)
DATABASE_URL=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable: changing this key makes saved account tokens unreadable.
ENCRYPTION_KEY=

DEBUG=0
